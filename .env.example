# Copy this file to ".env" and put your real key in it.
# Get a free key from https://aistudio.google.com/app/api-keys
GOOGLE_API_KEY=your_actual_api_key_here

# Optional: change models without touching the code.
# (If a model name is not available for your key, swap it here.)
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
